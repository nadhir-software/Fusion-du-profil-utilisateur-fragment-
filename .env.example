PROJECT_NAME=maha_these
DATA_DIR=data
MODEL_DIR=models
LOG_LEVEL=INFO

# --- Reddit (Couche 1 — crawler) ---
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=FederatedProfiler/1.0

# --- HuggingFace (accès Mistral-7B) ---
HUGGINGFACE_TOKEN=hf_xxxxx

# --- MLflow (tracking expériences) ---
MLFLOW_TRACKING_URI=./mlruns

# --- API ---
API_SECRET_KEY=your_secret_key

# --- Catalogue de recommandation (dataset Amazon Reviews 2023, McAuley) ---
# Catalogue MULTI-CATÉGORIES (séparées par des virgules) -> riche ET diversifié :
# chaque persona trouve des items pertinents dans son domaine. Défaut : magazines
# (cross-domaine, tous sujets) + santé/fitness + musique.
# Pour des produits tech/gaming réels, ajouter : ,Video_Games,Software (plus lourd).
AMAZON_CATALOG_CATEGORY=Magazine_Subscriptions,Health_and_Personal_Care,Digital_Music
AMAZON_CATALOG_LIMIT=1500   # items max PAR catégorie

# --- Store de profils (RAM only) ---
# "memory" (défaut, local au process) | "redis" (partagé multi-process)
PROFILE_STORE_BACKEND=memory
# Requiert un Redis SANS persistance : redis-server --save "" --appendonly no
REDIS_URL=redis://localhost:6379/0
